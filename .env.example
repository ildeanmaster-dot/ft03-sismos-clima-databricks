# Copie para .env. Não versione o .env.
# Databricks (CLI na máquina local; não é usado dentro do notebook)
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=  # prefira 'databricks auth login --host ...' (OAuth); token só como alternativa

# Parâmetros do pipeline (não secretos)
FT03_CATALOGO=ft03_sismos_clima
FT03_DATA_INICIO=2026-10-01
FT03_DATA_FIM=2026-10-31
FT03_MAGNITUDE_MINIMA=5
# Open-Meteo: chave só para plano pago (parâmetro apikey); vazio no plano gratuito
OPEN_METEO_APIKEY=
